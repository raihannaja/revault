    {
      "name": "C. Penolakan (harus 401)",
      "item": [
        {
          "name": "C1 Tanpa token -> 401 Unauthenticated.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/programs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "programs"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "C2 Token invalid -> 401 Token is invalid.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/programs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "programs"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalidtoken",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "C3 POST tanpa token -> 401",
          "request": {
