      ]
    },
    {
      "name": "B. Protected API dengan token valid (Task 02 dan 03)",
      "item": [
        {
          "name": "B1 GET semua program -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/programs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "programs"
              ]
            }
          }
        },
        {
          "name": "B2 POST buat program -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
